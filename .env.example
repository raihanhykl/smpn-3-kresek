# === Database (MySQL 8) ===
# Dev/prod database (Prisma CLI + app runtime read this).
# MySQL has no schema namespace param — do NOT append ?schema=public.
# Percent-encode any URL-special chars in the password (@ -> %40, etc.).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/smpn_3_kresek_pkm"
# Dedicated database for integration + e2e tests. MUST be a separate DB —
# tests run destructive wipe/seed cycles and will erase whatever DATABASE_URL points at.
TEST_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/smpn_3_kresek_pkm_test"

# === Auth (NextAuth v5) ===
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# v5 naming (NOT NEXTAUTH_URL). Set to actual deploy URL in production.
AUTH_URL="http://localhost:3000"

# === Data source toggle (existing) ===
# Phase 0 keeps this on "static". Phase 1 switches to "api".
NEXT_PUBLIC_DATA_SOURCE=static

# === Cloudinary (Phase 3) ===
# Free tier OK. Get from https://cloudinary.com/console.
# CLOUD_NAME is also the public name and appears in every media URL.
# API_SECRET MUST stay server-only (no NEXT_PUBLIC_ prefix).
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
